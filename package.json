{
  "name": "my-lovely-bible",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:paper": "tsc --noEmit && vite build --mode paper --outDir dist-paper",
    "dev:paper": "vite --mode paper",
    "build:site": "tsc --noEmit && vite build --mode paper --outDir site-dist/app --emptyOutDir && node -e \"require('fs').cpSync('landing','site-dist',{recursive:true})\"",
    "preview:site": "vite preview --outDir site-dist",
    "dev:paper2": "vite --mode paper2",
    "build:paper2": "tsc --noEmit && vite build --mode paper2 --outDir dist-paper2 --emptyOutDir",
    "build:pages": "npm run build && npm run build:site && npm run build:paper2 && node -e \"const fs=require('fs');fs.cpSync('site-dist','dist/paper',{recursive:true});fs.cpSync('dist-paper2','dist/paper/v2',{recursive:true})\"",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "apk": "npm run build:android && cd android && gradlew.bat assembleRelease",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
